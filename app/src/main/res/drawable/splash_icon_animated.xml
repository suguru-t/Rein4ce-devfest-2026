<?xml version="1.0" encoding="utf-8"?>
<!-- 起動画面のアイコンの動き（Android 12 以降）：最後の「ミ」のブロックが右の外から回りながら落ちてきて、
     着いたところで大きく 1 回・小さく 1 回はねてから、採集画面の題字と同じ位置（少し浮いて傾いた「置く直前」）に収まる（約 0.46 秒）。
     見えるのは直径 192dp の円の中だけなので、円の右の端から見え始める。
     絵は splash_icon（tools/make_splash_icon.py で作る。落ち始める位置 260・-70 と傾き 60 は、そこで渡した値と合わせる） -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <target android:name="drop">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <!-- 右の外から、回りながら落ちてくる（横は一定の速さ、下へはだんだん速く） -->
                <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateX"
                        android:valueType="floatType"
                        android:valueFrom="260"
                        android:valueTo="0"
                        android:duration="140"
                        android:interpolator="@android:interpolator/linear" />
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueType="floatType"
                        android:valueFrom="-70"
                        android:valueTo="0"
                        android:duration="140"
                        android:interpolator="@android:interpolator/accelerate_quad" />
                    <objectAnimator
                        android:propertyName="rotation"
                        android:valueType="floatType"
                        android:valueFrom="60"
                        android:valueTo="0"
                        android:duration="140"
                        android:interpolator="@android:interpolator/decelerate_quad" />
                </set>
                <!-- 着いたところで、大きくはね上がる（少し傾く） -->
                <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueType="floatType"
                        android:valueFrom="0"
                        android:valueTo="-16"
                        android:duration="100"
                        android:interpolator="@android:interpolator/decelerate_quad" />
                    <objectAnimator
                        android:propertyName="rotation"
                        android:valueType="floatType"
                        android:valueFrom="0"
                        android:valueTo="-8"
                        android:duration="100"
                        android:interpolator="@android:interpolator/decelerate_quad" />
                </set>
                <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueType="floatType"
                        android:valueFrom="-16"
                        android:valueTo="0"
                        android:duration="100"
                        android:interpolator="@android:interpolator/accelerate_quad" />
                    <objectAnimator
                        android:propertyName="rotation"
                        android:valueType="floatType"
                        android:valueFrom="-8"
                        android:valueTo="0"
                        android:duration="100"
                        android:interpolator="@android:interpolator/accelerate_quad" />
                </set>
                <!-- もう一度、小さくはねて収まる -->
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueType="floatType"
                    android:valueFrom="0"
                    android:valueTo="-5"
                    android:duration="60"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueType="floatType"
                    android:valueFrom="-5"
                    android:valueTo="0"
                    android:duration="60"
                    android:interpolator="@android:interpolator/accelerate_quad" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
