<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 画面ロック中も記録するためのフォアグラウンドサービス（Android 14 以降は type ごとの権限が必須） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13 以降、「記録中」通知を出すのに必要 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ACCESS_BACKGROUND_LOCATION は使わない（アプリを開いた状態でサービスを開始すれば不要） -->

    <application
        android:name=".RoadCollectorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoadCollector"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic はローカルサーバ（http://10.0.2.2:8080）用。Cloud Run は https なので本番では false にしてよい -->

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- 画面は縦向きだけ。どの画面も縦長で作っていて、横にすると地図やカードが大きくなりすぎるため。
             （Android 16 以降のタブレットや、開いた折りたたみスマホのような大きな画面では、この指定は無視されることがある） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".collect.LocationRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
