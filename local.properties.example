# Android Studio が自動生成する local.properties に、以下の行を追加してください。
# （local.properties は git に含めない）

# Maps SDK for Android の API キー。空のままでも動く（地図の代わりに軌跡を Canvas で描く）
# ふつうはここではなく、パソコンのユーザーの ~/.gradle/gradle.properties（Windows は C:\Users\<ユーザー名>\.gradle\gradle.properties）に
# 1 回だけ書く。そうすると、どのクローン・作業フォルダ（git worktree）でも読まれる（README の「地図（Maps API キー）」）。
# ここに書いた場合は、こちらが先に読まれる
MAPS_API_KEY=

# サーバの URL。既定は本番サーバ（Cloud Run）。この行がなくても本番につながる
# ローカルで ./gradlew :server:run したサーバを使うときだけ http://10.0.2.2:8080 に書き換える
# （10.0.2.2 はエミュレータから見たホスト PC の localhost）
SERVER_BASE_URL=https://road-collector-415368216017.asia-northeast1.run.app
